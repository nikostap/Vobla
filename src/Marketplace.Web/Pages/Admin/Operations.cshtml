@page
@model Marketplace.Web.Pages.Admin.OperationsModel
@{ ViewData["Title"] = "Операции и аудит"; }
<partial name="Shared/_AccountNav" /><main class="account-page page-shell admin-page"><partial name="_AdminNav" /><header class="account-title"><div><span class="eyebrow">Система</span><h1>Операции и аудит</h1><p>Feature flags, ручной запуск фоновых задач и неизменяемый журнал действий.</p></div></header>
<section class="detail-card"><h2>Feature flags</h2><div class="flag-list">@foreach (var flag in Model.Flags) { <article><div><strong>@flag.Key</strong><p>@flag.Description</p></div><form method="post" asp-page-handler="Flag"><input type="hidden" name="id" value="@flag.Id" /><input name="reason" required minlength="5" placeholder="Причина изменения" /><button class="ui-button" type="submit" disabled="@User.IsInRole("Auditor")">@(flag.IsEnabled ? "Включён" : "Выключен")</button></form></article> }</div></section>
<section class="detail-card"><div class="section-heading"><div><h2>Фоновые задачи</h2><p>Запуски сохраняются в durable-очереди, worker повторяет временные ошибки до трёх раз.</p></div><div class="job-actions"><form method="post" asp-page-handler="RunJob"><input type="hidden" name="job" value="history-retention" /><button class="ui-button" type="submit">Очистить историю 30+</button></form><form method="post" asp-page-handler="RunJob"><input type="hidden" name="job" value="saved-search-matches" /><button class="ui-button primary" type="submit">Проверить поиски</button></form><form method="post" asp-page-handler="RunJob"><input type="hidden" name="job" value="upload-temp-cleanup" /><button class="ui-button" type="submit">Очистить temp-файлы</button></form><form method="post" asp-page-handler="RunJob"><input type="hidden" name="job" value="otp-challenge-cleanup" /><button class="ui-button" type="submit">Очистить OTP</button></form><form method="post" asp-page-handler="RunJob"><input type="hidden" name="job" value="auth-rate-limit-cleanup" /><button class="ui-button" type="submit">Очистить auth buckets</button></form><form method="post" asp-page-handler="RunJob"><input type="hidden" name="job" value="session-retention" /><button class="ui-button" type="submit">Очистить сессии</button></form></div></div><ol class="history-list">@foreach (var job in Model.Jobs) { <li><strong>@job.JobName · @job.Status · попытка @job.Attempts</strong><span>@job.Detail</span><time>@job.StartedAt.ToLocalTime().ToString("dd.MM HH:mm")</time></li> }</ol></section>
<section class="detail-card"><h2>Аудит</h2><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Время</th><th>Событие</th><th>Объект</th><th>Изменение / причина</th><th>Correlation</th></tr></thead><tbody>@foreach (var item in Model.Audit) { <tr><td>@item.CreatedAt.ToLocalTime().ToString("dd.MM HH:mm:ss")</td><td><strong>@item.EventType</strong><small>@item.ActorRole · @item.IpAddress</small></td><td>@item.EntityType @item.EntityId</td><td>@item.OldValue → @item.NewValue<small>@item.Reason @item.Detail</small></td><td><code>@item.CorrelationId</code></td></tr> }</tbody></table></div></section></main>
