@page
@model Marketplace.Web.Pages.Admin.ModerationReviewModel
@{ ViewData["Title"] = "Проверка объявления"; }
<partial name="Shared/_AccountNav" />
<div class="page-shell"><partial name="_AdminNav" /></div>
<main class="moderation-page page-shell">
    @if (Model.Case is not null) { <nav class="breadcrumbs"><a asp-page="/Admin/Moderation">Очередь</a><span>›</span><span>@Model.Case.Title</span></nav><div class="review-layout"><section><article class="detail-card"><div class="review-heading"><span class="ui-badge risk-@Model.Case.RiskLevel.ToLowerInvariant()">@Model.Case.RiskLevel</span><small>Ruleset @Model.Case.RuleSetVersion</small></div><h1>@Model.Case.Title</h1><strong class="detail-price">@Model.Case.PriceLabel</strong><p>@Model.Case.Description</p><dl class="attribute-list"><dt>Категория</dt><dd>@Model.Case.Category</dd><dt>Пользователь</dt><dd>@Model.Case.OwnerName</dd><dt>Телефон</dt><dd class="privacy-redacted">Скрыт политикой доступа</dd></dl></article>
        @if (Model.Case.Appeals.Count > 0) { <article class="detail-card appeal-card"><h2>Апелляция пользователя</h2>@foreach (var appeal in Model.Case.Appeals) { <blockquote>@appeal.Message</blockquote><small>Подана @appeal.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</small> }</article> }
        <article class="detail-card"><h2>Срабатывания правил</h2>@if (Model.Case.Findings.Count == 0) { <p>Автоматические правила не нашли нарушений.</p> } else { <div class="finding-list">@foreach (var item in Model.Case.Findings) { <div><span class="ui-badge risk-@item.Risk.ToLowerInvariant()">@item.Code · @item.Risk</span><strong>@item.Fragment</strong><p>@item.RecommendedAction</p><small>@item.RuleCode v@(item.RuleVersion) · уверенность @item.Confidence</small></div> }</div> }</article></section>
        <aside class="detail-card decision-panel"><h2>Решение</h2><form method="post"><input type="hidden" name="id" value="@Model.Case.Id" /><div class="field"><label asp-for="Input.Reason">Понятная причина</label><textarea asp-for="Input.Reason" required></textarea></div><div class="field"><label asp-for="Input.ProblemField">Проблемное поле</label><input asp-for="Input.ProblemField" placeholder="Описание, фото, категория" /></div><div class="field"><label asp-for="Input.RuleReference">Ссылка на правило</label><input asp-for="Input.RuleReference" placeholder="rules/prohibited-goods" /></div><div class="field"><label asp-for="Input.Instruction">Как исправить</label><textarea asp-for="Input.Instruction"></textarea></div><div class="decision-actions"><button class="ui-button primary" name="action" value="Approve">Одобрить</button><button class="ui-button" name="action" value="NeedsCorrection">Запросить исправление</button><button class="ui-button danger" name="action" value="Reject">Отклонить</button><button class="ui-button" name="action" value="Escalate">Эскалировать</button></div></form></aside></div> }
</main>
