@page
@model Marketplace.Web.Pages.Admin.FinanceModel
@{ ViewData["Title"] = "Финансовые операции"; }
<partial name="Shared/_AccountNav" /><main class="account-page page-shell admin-page"><partial name="_AdminNav" /><header class="account-title"><div><span class="eyebrow">M12 · Sandbox</span><h1>Возвраты и финансовый аудит</h1><p>Оператор подготавливает возврат, контролёр подтверждает. Реальных денежных вызовов нет.</p></div></header><div class="refund-list">@foreach (var item in Model.Refunds) { <article class="detail-card"><div><span class="ui-badge">@item.Status</span><h2>@item.Product</h2><p>@item.Reason</p><strong>@item.Cash.ToString("N0") ₽ + @item.Bonus.ToString("N0") бонусов</strong></div>@if (item.Status == "Pending") { <form method="post" asp-page-handler="Prepare"><input type="hidden" name="id" value="@item.Id" /><input name="note" required minlength="5" placeholder="Проверка оператора" /><button class="ui-button" type="submit">Подготовить</button></form> } else if (item.Status == "Prepared") { <form method="post" asp-page-handler="Resolve"><input type="hidden" name="id" value="@item.Id" /><input name="note" required minlength="5" placeholder="Решение контролёра" /><button class="ui-button primary" name="approve" value="true" type="submit">Подтвердить возврат</button><button class="ui-button" name="approve" value="false" type="submit">Отклонить</button></form> }</article> }</div></main>
