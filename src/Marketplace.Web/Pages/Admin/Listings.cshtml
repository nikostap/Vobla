@page
@model Marketplace.Web.Pages.Admin.ListingsModel
@{ ViewData["Title"] = "Управление объявлениями"; }
<partial name="Shared/_AccountNav" /><main class="account-page page-shell admin-page"><partial name="_AdminNav" /><header class="account-title"><div><span class="eyebrow">Контент</span><h1>Объявления</h1><p>Операционные изменения статуса с обязательной причиной и историей.</p></div><form method="get"><input type="search" name="q" placeholder="Название" /><select name="status"><option value="">Все статусы</option><option>Active</option><option>PendingManualReview</option><option>Quarantine</option><option>Rejected</option><option>Deleted</option></select><button class="ui-button" type="submit">Фильтр</button></form></header>
<div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Объявление</th><th>Категория</th><th>Владелец</th><th>Статус</th><th>Действие</th></tr></thead><tbody>@foreach (var item in Model.Listings) { <tr><td><a asp-page="/Listings/Details" asp-route-id="@item.Id"><strong>@item.Title</strong></a><small>@(item.Price is null ? "—" : $"{item.Price:N0} ₽") · @item.UpdatedAt.ToLocalTime().ToString("dd.MM HH:mm")</small></td><td>@item.Category</td><td>@item.Owner</td><td><span class="ui-badge">@item.Status</span></td><td><form method="post" asp-page-handler="Status"><input type="hidden" name="id" value="@item.Id" /><select name="status"><option>Active</option><option>Quarantine</option><option>Rejected</option><option>Deleted</option></select><input name="reason" required minlength="5" placeholder="Причина" /><button class="ui-button" type="submit">Изменить</button></form></td></tr> }</tbody></table></div></main>
