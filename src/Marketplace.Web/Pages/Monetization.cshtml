@page
@model Marketplace.Web.Pages.MonetizationModel
@{ ViewData["Title"] = "Тарифы и продвижение"; }
<partial name="Shared/_AccountNav" /><main class="account-page page-shell monetization-page"><header class="account-title"><div><span class="eyebrow">M12 · Только sandbox</span><h1>Тарифы и продвижение</h1><p>Реальные платежи выключены. Лимит: @Model.ActiveListingLimit объявлений · бонусы: @Model.BonusBalance.ToString("N0") ₽.</p></div></header>
@if (TempData["Notice"] is string notice) { <div class="notice notice--success">@notice</div> } @if (TempData["Error"] is string error) { <div class="notice notice--error">@error</div> }
<section class="detail-card"><h2>Тарифы</h2><div class="product-grid">@foreach (var plan in Model.Plans) { <article><span class="ui-badge">до @plan.ActiveListingLimit объявлений</span><h3>@plan.Name</h3><strong>@plan.MonthlyPrice.ToString("N0") ₽ / месяц</strong><p>@plan.AnnualPrice.ToString("N0") ₽ / год</p>@if (plan.MonthlyPrice > 0) { <form method="post" asp-page-handler="Purchase"><input type="hidden" name="productType" value="Plan" /><input type="hidden" name="productCode" value="@plan.Code" /><input type="hidden" name="idempotencyKey" value="@Model.IdempotencyKey-plan-@plan.Code" /><input name="promoCode" placeholder="Промокод" /><label><input type="checkbox" name="useBonus" value="true" /> Списать бонусы</label><button class="ui-button primary" type="submit">Купить в sandbox</button></form> }</article> }</div></section>
<section class="detail-card"><h2>Продвижение</h2><div class="product-grid">@foreach (var product in Model.Products) { <article><span class="ui-badge">@product.DurationDays дней</span><h3>@product.Name</h3><strong>@product.Price.ToString("N0") ₽</strong><p>@product.Description</p><form method="post" asp-page-handler="Purchase"><input type="hidden" name="productType" value="Promotion" /><input type="hidden" name="productCode" value="@product.Code" /><input type="hidden" name="idempotencyKey" value="@Model.IdempotencyKey-promo-@product.Code" /><select name="listingId" required><option value="">Выберите объявление</option>@foreach (var listing in Model.Listings) { <option value="@listing.Id">@listing.Title</option> }</select><input name="promoCode" placeholder="Промокод" /><label><input type="checkbox" name="useBonus" value="true" /> Списать бонусы</label><button class="ui-button primary" type="submit" disabled="@(Model.Listings.Count == 0)">Продвинуть</button></form></article> }</div></section>
<section class="detail-card"><h2>История sandbox-платежей</h2>@if (Model.Transactions.Count == 0) { <p>Операций пока нет.</p> } else { <div class="payment-list">@foreach (var item in Model.Transactions) { <article><div><strong>@item.ProductCode · @item.Status</strong><small>@item.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm") · деньги @item.CashAmount.ToString("N0") ₽ · бонусы @item.BonusUsed.ToString("N0") ₽</small></div>@if (item.Kind == "Purchase" && item.Status == "Succeeded" && !Model.RefundedOrRequested.Contains(item.Id)) { <form method="post" asp-page-handler="Refund"><input type="hidden" name="paymentId" value="@item.Id" /><input name="reason" required minlength="5" placeholder="Причина возврата" /><button class="ui-button" type="submit">Запросить возврат</button></form> }</article> }</div> }</section></main>
