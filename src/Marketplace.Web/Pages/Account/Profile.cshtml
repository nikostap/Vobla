@page
@model Marketplace.Web.Pages.Account.ProfileModel
@{ ViewData["Title"] = "Профиль"; }
<partial name="Shared/_AccountNav" />
<main class="account-page page-shell">
    <header class="account-title">
        <div class="profile-avatar">@if (Model.AvatarUrl is not null) { <img src="@Model.AvatarUrl" alt="" /> } else { @Model.Initial }</div>
        <div>
            <span class="eyebrow">Личный кабинет</span><h1>Профиль и приватность</h1>
            <p>@Model.Email · на Marketplace с @Model.RegisteredAt.ToString("MMMM yyyy")</p>
        </div>
        <form method="post" asp-page="/Account/SignOut"><button class="ui-button ghost" type="submit">Выйти</button></form>
    </header>
    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage)) { <div class="notice notice--success" role="status">@Model.StatusMessage</div> }
    <form method="post" class="settings-grid">
        <section class="settings-card">
            <h2>Публичные данные</h2><p>Эту информацию увидят другие пользователи.</p>
            <div class="avatar-editor" data-avatar-editor>
                <div class="avatar-editor__preview" data-avatar-preview>@if (Model.AvatarUrl is not null) { <img src="@Model.AvatarUrl" alt="Текущий аватар" /> }</div>
                <div><label class="ui-button" for="avatar-file">Выбрать фото</label><input id="avatar-file" type="file" accept="image/jpeg,image/png,image/webp" hidden data-avatar-file /><p>После выбора переместите и увеличьте фото, затем подтвердите кадр.</p></div>
                <input asp-for="Input.AvatarCropData" type="hidden" data-avatar-data />
                <dialog class="avatar-crop-dialog" data-avatar-dialog><div class="avatar-crop-panel"><h3>Кадрирование аватара</h3><div class="avatar-crop-stage" data-avatar-stage><img alt="Предпросмотр кадрирования" data-avatar-image /></div><label>Масштаб <input type="range" min="0.35" max="3" step="0.01" value="1" data-avatar-zoom /></label><small>Уменьшите масштаб, чтобы фотография целиком поместилась в круг, или увеличьте для крупного плана.</small><div class="wizard-actions"><button class="ui-button" type="button" data-avatar-cancel>Отмена</button><button class="ui-button primary" type="button" data-avatar-accept>Применить</button></div></div></dialog>
            </div>
            <div class="field"><label asp-for="Input.DisplayName">Отображаемое имя</label><input asp-for="Input.DisplayName" autocomplete="name" /><span asp-validation-for="Input.DisplayName" class="field-error"></span></div>
            <div class="field profile-city-field" data-city-editor data-suggest-url="/maps-api/api/v1/geo/suggest"><label asp-for="Input.Address">Адрес</label><input asp-for="Input.Address" autocomplete="street-address" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="profile-address-suggestions" placeholder="Город, улица и дом" /><input asp-for="Input.CityLatitude" type="hidden" /><input asp-for="Input.CityLongitude" type="hidden" /><div id="profile-address-suggestions" class="address-suggestions" role="listbox" hidden></div><small>Введите полный адрес и выберите вариант из подсказок. Он хранится в профиле и не показывается другим автоматически.</small><span asp-validation-for="Input.Address" class="field-error"></span></div>
            <div class="field"><label asp-for="Input.Bio">О себе</label><textarea asp-for="Input.Bio" maxlength="800" placeholder="Расскажите, что вы продаёте или ищете"></textarea></div>
        </section>
        <section class="settings-card">
            <h2>Приватность</h2><p>Настройки применяются ко всему аккаунту.</p>
            @foreach (var setting in Model.PrivacySettings)
            {
                <label class="toggle-row">
                    <span><strong>@setting.Label</strong><small>@setting.Description</small></span>
                    <input type="checkbox" name="Input.@setting.Name" value="true" checked="@setting.Checked" />
                    <input type="hidden" name="Input.@setting.Name" value="false" />
                </label>
            }
        </section>
        <div class="settings-actions"><button class="ui-button primary" type="submit">Сохранить изменения</button><a class="ui-button" asp-page="/Account/Sessions">Управлять сессиями</a><a class="ui-button danger" asp-page="/Account/Data" asp-fragment="delete-account">Удалить учётную запись</a></div>
    </form>
</main>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
